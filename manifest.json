{
  "schemaVersion": 1,
  "id": "crbelaus.twingate",
  "name": "Twingate",
  "version": "2.0.0",
  "author": "crbelaus",
  "description": "Twingate VPN connection status and toggle",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Twingate",
    "description": "Twingate VPN connection status, click to connect/disconnect",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 15
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
